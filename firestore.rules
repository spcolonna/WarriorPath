rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users ──────────────────────────────────────────────────────────────
    // Lectura/actualización/borrado: cualquier usuario autenticado (igual que
    // antes; los maestros leen y actualizan los docs de sus alumnos, etc.).
    match /users/{userId} {
      allow read, update, delete: if request.auth != null;

      // ANTI-SPAM: un usuario solo puede crear SU PROPIO documento si tiene el
      // email verificado. Esto frena la creación masiva de cuentas por script.
      // La creación de perfiles proxy (hijos / alumnos sin app) la hace otro
      // usuario autenticado con un id distinto, y sigue permitida.
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.auth.token.email_verified == true) ||
        (request.auth.uid != userId)
      );
    }

    // ── schools y TODAS sus subcolecciones ─────────────────────────────────
    // (disciplines, levels, techniques, members, payments, progressionHistory,
    //  paymentReminders, attendanceRecords, classSchedules, paymentPlans, events)
    // Se mantiene el comportamiento actual: acceso para autenticados.
    match /schools/{schoolId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── guardianships ──────────────────────────────────────────────────────
    match /guardianships/{guardianshipId} {
      allow read, write: if request.auth != null;
    }

    // ── consultas collectionGroup('payments') (pantalla de finanzas) ───────
    // Las queries de grupo de colección necesitan una regla con wildcard
    // recursivo como prefijo; las reglas por ruta específica no aplican a ellas.
    match /{path=**}/payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
  }
}
